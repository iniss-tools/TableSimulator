<Project Sdk="Microsoft.NET.Sdk">
	<!-- Jadro simulatora bez UI a bez Windows: linky, protokoly tabul, stav tabul, zaznam komunikacie. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>TableSimulator.Core</RootNamespace>
		<AssemblyName>TableSimulator.Core</AssemblyName>
		<LangVersion>default</LangVersion>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="TableSimulator.Tests" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\ToolsCore\ToolsCore.Iniss\ToolsCore.Iniss.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- seriova linka a zrkadlenie linky na COM port (virtualny par COM portov, ELEN Monitor) -->
		<PackageReference Include="System.IO.Ports" Version="10.0.12" />
		<!-- zaznamy spojeni liniek; zapisuje ich server (Serilog) -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
	</ItemGroup>
</Project>
