<Project Sdk="Microsoft.NET.Sdk">
	<!-- Server simulatora: endpointy API (Api/), WebSocket a infrastruktura (Infrastructure/), webove rozhranie vo wwwroot. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>TableSimulator</RootNamespace>
		<AssemblyName>TableSimulator</AssemblyName>
		<LangVersion>default</LangVersion>
		<WebDir>$(MSBuildProjectDirectory)\..\web</WebDir>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<!-- ako implicitne usingy Microsoft.NET.Sdk.Web (Web SDK sa nepouziva kvoli wwwroot vo vystupe) -->
		<Using Include="Microsoft.AspNetCore.Builder" />
		<Using Include="Microsoft.AspNetCore.Hosting" />
		<Using Include="Microsoft.AspNetCore.Http" />
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="Microsoft.Extensions.Hosting" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\TableSimulator.Application\TableSimulator.Application.csproj" />
		<ProjectReference Include="..\TableSimulator.Contracts\TableSimulator.Contracts.csproj" />
		<ProjectReference Include="..\TableSimulator.Core\TableSimulator.Core.csproj" />
		<ProjectReference Include="..\TableSimulator.Persistence\TableSimulator.Persistence.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
		<PackageReference Include="ModelContextProtocol.Extensions.Apps" Version="2.2.0" />
		<PackageReference Include="Scrutor" Version="7.0.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<!-- Webove rozhranie (bun + vite) sa zostavi do wwwroot pred buildom; -p:SkipWebBuild=true ho vynecha.
	     Zdroje webu su polozky az v cieli - staticku ItemGroup by IDE ukazovalo ako odkazy v koreni projektu. -->
	<Target Name="CollectWebSource">
		<ItemGroup>
			<WebSource Include="$(WebDir)\src\**\*;$(WebDir)\public\**\*;$(WebDir)\index.html;$(WebDir)\mcp-app.html;$(WebDir)\vite.mcp.config.ts;$(WebDir)\package.json;$(WebDir)\bun.lock;$(WebDir)\vite.config.ts;$(WebDir)\tsconfig.json" />
		</ItemGroup>
	</Target>
	<Target Name="BuildWeb" DependsOnTargets="CollectWebSource" BeforeTargets="BeforeBuild" Inputs="@(WebSource)" Outputs="$(MSBuildProjectDirectory)\wwwroot\index.html"
			Condition="'$(SkipWebBuild)' != 'true'">
		<Exec Command="bun install" WorkingDirectory="$(WebDir)" Condition="!Exists('$(WebDir)\node_modules')" />
		<Exec Command="bun run build" WorkingDirectory="$(WebDir)" />
	</Target>
	<Target Name="IncludeWeb" DependsOnTargets="BuildWeb" BeforeTargets="AssignTargetPaths">
		<ItemGroup>
			<Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>
</Project>
